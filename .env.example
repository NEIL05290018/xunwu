# 复制为 .env，然后填写本机 MySQL 连接参数。不要把 .env 发给他人。
# 下列关闭 TLS 的 URL 只用于本机课程开发，远程 MySQL 应配置 TLS。
DB_URL=jdbc:mysql://localhost:3306/xunwu?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
DB_USER=xunwu
DB_PASSWORD=ChangeThisDbPassword_2026
PORT=8080
# 首次启动空数据库时创建管理员 admin01；以后启动不会重置密码。
XUNWU_ADMIN_PASSWORD=ChangeAdminPassword_2026
# true：首次创建虚构示例数据；false：从空市场开始，用户自行注册。
XUNWU_SEED_DEMO=true
# 开启示例数据时，5 个示例用户初始密码均为该值。
XUNWU_DEMO_PASSWORD=ChangeUserPassword_2026
