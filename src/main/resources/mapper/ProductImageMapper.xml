<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.ProductImageMapper">
  <resultMap id="row" type="com.example.demo.model.ProductImage">
    <id column="image_id" property="image_id"/>
    <result column="product_id" property="product_id"/>
    <result column="image_url" property="image_url"/>
  </resultMap>
  <sql id="columns">image_id,product_id,image_url</sql>
  <select id="findAll" resultMap="row">SELECT <include refid="columns"/> FROM `product_images` ORDER BY image_id</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="image_id" keyColumn="image_id">INSERT INTO `product_images` (image_id,product_id,image_url) VALUES (#{image_id},#{product_id},#{image_url})</insert>
  <select id="findById" resultMap="row">SELECT <include refid="columns"/> FROM `product_images` WHERE image_id=#{id}</select>
  <update id="update">UPDATE `product_images` SET product_id=#{product_id},image_url=#{image_url} WHERE image_id=#{image_id}</update>
  <delete id="deleteById">DELETE FROM `product_images` WHERE image_id=#{id}</delete>
  <delete id="deleteByProduct">DELETE FROM product_images WHERE product_id=#{id}</delete>
</mapper>
