<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.FavoriteMapper">
  <resultMap id="row" type="com.example.demo.model.Favorite">
    <id column="user_id" property="user_id"/>
    <result column="product_id" property="product_id"/>
    <result column="favorited_at" property="favorited_at"/>
  </resultMap>
  <sql id="columns">user_id,product_id,favorited_at</sql>
  <select id="findAll" resultMap="row">SELECT <include refid="columns"/> FROM `favorites` ORDER BY user_id,product_id</select>
  <insert id="insert">INSERT INTO `favorites` (user_id,product_id,favorited_at) VALUES (#{user_id},#{product_id},#{favorited_at})</insert>
  <delete id="deleteByProduct">DELETE FROM favorites WHERE product_id=#{id}</delete>
  <delete id="deletePair">DELETE FROM favorites WHERE user_id=#{user} AND product_id=#{product}</delete>
</mapper>
