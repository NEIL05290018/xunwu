<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.SchemaMapper">
<select id="conversationVersion" resultType="int">SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='conversations' AND column_name IN ('pair_low','pair_high')</select>
<select id="adminCount" resultType="int">SELECT COUNT(*) FROM admins</select>
<select id="userCount" resultType="int">SELECT COUNT(*) FROM users</select>
</mapper>
